<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/GameHud.uss?fileID=7433441132597879392&amp;guid=1991c0c331ad4d479ddf1e1000000008&amp;type=3#GameHud"/>
    <ui:VisualElement name="MainContainer" class="hud-root">
        <ui:VisualElement class="task panel">
            <ui:Label text="SYS // 7.3.1" class="caption"/>
            <ui:Label text="GLOBAL TASK" class="caption task-heading"/>
            <ui:Label name="task-text" class="task-text"/>
        </ui:VisualElement>
        <ui:VisualElement class="meters">
            <ui:Label text="CLEAN" class="meter-label"/>
            <ui:VisualElement class="meter">
                <ui:VisualElement name="clean-fill" class="fill"/>
            </ui:VisualElement>
            <ui:Label text="PAINT" class="meter-label" style="visibility: hidden;"/>
            <ui:VisualElement class="meter" style="visibility: hidden;">
                <ui:VisualElement name="paint-fill" class="fill"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="tool-panel" class="tool-panel panel">
            <ui:Label text="TOOLS" class="caption tool-heading"/>
            <ui:VisualElement name="tool-slot-0" class="tool-slot">
                <ui:Label text="1" class="tool-key"/>
                <ui:Label name="tool-name-0" class="tool-name"/>
            </ui:VisualElement>
            <ui:VisualElement name="tool-slot-1" class="tool-slot">
                <ui:Label text="2" class="tool-key"/>
                <ui:Label name="tool-name-1" class="tool-name"/>
            </ui:VisualElement>
            <ui:VisualElement name="tool-slot-2" class="tool-slot">
                <ui:Label text="3" class="tool-key"/>
                <ui:Label name="tool-name-2" class="tool-name"/>
            </ui:VisualElement>
            <ui:VisualElement name="tool-slot-3" class="tool-slot">
                <ui:Label text="4" class="tool-key"/>
                <ui:Label name="tool-name-3" class="tool-name"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="object-card" class="object-card panel">
            <ui:Label name="object-title" class="object-title"/>
            <ui:Label name="object-description" class="object-description"/>
        </ui:VisualElement>
        <ui:VisualElement class="controls panel" style="visibility: hidden;">
            <ui:Label text="[WASD]  MOVE"/>
            <ui:Label text="[SHIFT] SPRINT"/>
            <ui:Label text="[SPACE] JUMP"/>
            <ui:Label text="[E]     INTERACT"/>
        </ui:VisualElement>
        <ui:Label name="time" text="TIME  00:00" class="time"/>
        <ui:Label name="critical-warning" class="critical-warning"/>
        <ui:VisualElement name="direction-arrow" class="direction-arrow" style="display: none;">
            <ui:VisualElement name="direction-arrow-body" class="arrow-body"/>
            <ui:Label name="direction-distance" text="" class="direction-distance"/>
        </ui:VisualElement>
        <ui:VisualElement name="hud-root" class="crosshair-host" style="top: 2px; left: 0;">
            <ui:VisualElement name="crosshair"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
