/* Intro.uss — вступительная катсцена: чёрно-зелёный терминал.
   Всё в процентах — работает на любом разрешении без скейла. */

.intro-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(5, 10, 5);
    font-family: "Courier New", "Consolas", monospace;
    padding: 8%;
}

.terminal-text {
    font-size: 32px;
    color: rgb(140, 255, 140);
    white-space: normal;
    -unity-text-align: upper-left;
}

.prompt-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 40px;
    font-size: 22px;
    color: rgb(190, 190, 190);
    -unity-text-align: middle-center;
}

/* Полностью чёрный слой поверх всего: плавно проявляется в конце катсцены,
   затем резко исчезает вместе с ней — «робот включился». */
.blackout {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}
