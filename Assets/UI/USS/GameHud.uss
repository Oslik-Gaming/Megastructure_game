.hud-root {
    width: 100%; height: 100%; color: rgb(0, 255, 95); -unity-font-style: bold;
    font-size: 14px; picking-mode: ignore;
}
.panel { position: absolute; border-width: 1px; border-color: rgb(0, 255, 95); background-color: rgba(0, 20, 8, .48); padding-left: 12px; padding-right: 12px; padding-top: 9px; padding-bottom: 9px; }
.task { left: 28px; top: 28px; width: 290px; }
.caption { font-size: 11px; color: rgb(110, 255, 150); }
.task-text { white-space: normal; margin-top: 5px; }
.meters { position: absolute; right: 30px; top: 30px; width: 230px; }
.meter-label { font-size: 13px; margin-top: 4px; }
.meter { height: 12px; border-width: 1px; border-color: rgb(0, 255, 95); background-color: rgba(0, 30, 10, .55); }
.fill { height: 100%; width: 100%; background-color: rgb(0, 255, 95); }
.controls { left: 28px; bottom: 28px; width: 205px; }
.object-card { left: 58%; top: 48%; width: 290px; }
.object-title { font-size: 16px; margin-bottom: 6px; }
.object-description { white-space: normal; font-size: 12px; }
.time { position: absolute; right: 30px; bottom: 30px; font-size: 13px; }
.critical-warning { position: absolute; left: 0; right: 0; top: 45%; -unity-text-align: middle-center; font-size: 32px; color: rgb(255, 55, 55); }
.crosshair-host { position: absolute; left: 0; top: 0; width: 100%; height: 100%; align-items: center; justify-content: center; picking-mode: ignore; }
#crosshair { width: 6px; height: 6px; border-radius: 50%; background-color: white; border-width: 0; border-color: white; picking-mode: ignore; transition-property: width, height, background-color, border-width, border-color; transition-duration: .15s; }
#crosshair.highlight { width: 28px; height: 28px; background-color: rgba(255,255,255,0); border-width: 2px; border-color: rgb(120,220,255); }
.critical .panel, .critical .meter { border-color: rgb(255, 55, 55); }
.critical .fill { background-color: rgb(255, 55, 55); }
.critical .task, .critical .meters, .critical .controls, .critical .object-card, .critical .time { color: rgb(255, 55, 55); }
.critical .caption { color: rgb(255, 55, 55); }
