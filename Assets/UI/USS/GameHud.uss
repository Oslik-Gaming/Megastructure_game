/* Game HUD — terminal interface, tuned for 1920x1080. */
.hud-root {
    width: 100%;
    height: 100%;
    color: rgb(0, 255, 110);
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    position: relative;
}

/* Shared translucent terminal panel. */
.panel {
    position: absolute;
    border-width: 1px;
    border-color: rgb(0, 255, 110);
    background-color: rgba(0, 18, 10, 0.72);
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 11px;
    padding-bottom: 11px;
}

/* Mission data, upper-left. */
.task {
    left: 28px;
    top: 27px;
    width: 310px;
    min-height: 88px;
}

.caption {
    font-size: 11px;
    color: rgb(102, 255, 155);
    letter-spacing: 2px;
}

.task-heading {
    margin-top: 10px;
    color: rgb(0, 255, 110);
}

.task-text {
    white-space: normal;
    margin-top: 6px;
    color: rgb(0, 255, 110);
    font-size: 12px;
}

/* Resource meters, upper-right. */
.meters {
    position: absolute;
    right: 30px;
    top: 29px;
    width: 250px;
}

.meter-label {
    font-size: 11px;
    margin-top: 4px;
    color: rgb(0, 255, 110);
    letter-spacing: 2px;
}

.meter {
    height: 11px;
    margin-top: 3px;
    border-width: 1px;
    border-color: rgb(0, 255, 110);
    background-color: rgba(0, 45, 20, 0.7);
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.fill {
    height: 100%;
    width: 100%;
    background-color: rgb(0, 255, 110);
}

/* Interaction hints, lower-left. */
.controls {
    left: 28px;
    bottom: 28px;
    width: 235px;
    min-height: 91px;
    color: rgb(0, 255, 110);
    font-size: 12px;
}

.controls > Label {
    margin-bottom: 8px;
}

/* Tool slots, right side under the meters. */
.tool-panel {
    right: 30px;
    top: 122px;
    width: 190px;
}

.tool-heading {
    margin-bottom: 4px;
}

.tool-slot {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding-left: 6px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-width: 1px;
    border-color: rgba(0, 255, 110, 0.35);
    background-color: rgba(0, 45, 20, 0.55);
    transition-property: border-color, background-color, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.tool-key {
    width: 18px;
    height: 18px;
    border-width: 1px;
    border-color: rgb(0, 255, 110);
    font-size: 10px;
    -unity-text-align: middle-center;
    margin-right: 8px;
}

.tool-name {
    flex-grow: 1;
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(0, 255, 110);
}

/* Unlocked tool that is not currently held. */
.tool-slot.unlocked {
    border-color: rgba(0, 255, 110, 0.7);
}

/* Tool the player is holding right now. */
.tool-slot.active {
    border-color: rgb(0, 255, 110);
    background-color: rgba(0, 255, 110, 0.18);
}

/* Inspectable object information. */
.object-card {
    left: 58%;
    top: 48%;
    width: 305px;
    min-height: 96px;
    border-width: 1px;
}

.object-title {
    font-size: 14px;
    margin-bottom: 7px;
    color: rgb(0, 255, 110);
    letter-spacing: 2px;
}

.object-description {
    white-space: normal;
    font-size: 11px;
    color: rgb(0, 255, 110);
    letter-spacing: 0.5px;
}

/* Session time, lower-right. */
.time {
    position: absolute;
    right: 30px;
    bottom: 30px;
    font-size: 11px;
    color: rgb(0, 255, 110);
    letter-spacing: 2px;
}

/* Static danger-zone warning. GameHud toggles the critical class. */
.critical-warning {
    position: absolute;
    left: 660px;
    top: 320px;
    width: 600px;
    min-height: 72px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-width: 1px;
    border-color: rgb(255, 35, 60);
    background-color: rgba(55, 0, 8, 0.78);
    -unity-text-align: middle-center;
    font-size: 25px;
    color: rgb(255, 35, 60);
    letter-spacing: 3px;
}

/* Flat green direction arrow, bottom center of the screen.
   Само изображение стрелки назначается кодом. */
.direction-arrow {
    position: absolute;
    left: 50%;
    bottom: 40px;
    width: 58px;
    height: 58px;
    translate: -50% 0;
}

/* Rotating arrow body: procedural texture is assigned from code. */
.arrow-body {
    position: absolute;
    left: 0;
    top: 0;
    width: 58px;
    height: 58px;
}

/* Distance readout, to the right of the arrow. */
.direction-distance {
    position: absolute;
    left: 70px;
    top: 50%;
    translate: 0 -50%;
    font-size: 19px;
    letter-spacing: 2px;
    color: rgb(0, 255, 110);
    white-space: nowrap;
    -unity-text-align: middle-left;
    border-width: 1px;
    border-color: rgba(0, 255, 110, 0.5);
    background-color: rgba(0, 18, 10, 0.72);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* Crosshair. */
.crosshair-host {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

#crosshair {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: rgb(0, 255, 110);
    border-width: 0;
    border-color: rgb(0, 255, 110);
    transition-property: width, height, background-color, border-width, border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

#crosshair.highlight {
    width: 26px;
    height: 26px;
    background-color: rgba(0, 255, 110, 0);
    border-width: 2px;
    border-color: rgb(0, 255, 110);
}

/* Critical state: same layout, red terminal palette. */
.critical .panel,
.critical .meter {
    border-color: rgb(255, 35, 60);
}

.critical .fill {
    background-color: rgb(255, 35, 60);
}

.critical .task,
.critical .meters,
.critical .controls,
.critical .object-card,
.critical .time,
.critical .caption,
.critical .task-text,
.critical .meter-label,
.critical .object-title,
.critical .object-description,
.critical .tool-name,
.critical .tool-key {
    color: rgb(255, 35, 60);
    border-color: rgb(255, 35, 60);
}

.critical .tool-slot {
    border-color: rgba(255, 35, 60, 0.5);
}

.critical .tool-slot.active {
    border-color: rgb(255, 35, 60);
    background-color: rgba(255, 35, 60, 0.15);
}

.critical .direction-distance {
    color: rgb(255, 35, 60);
    border-color: rgba(255, 35, 60, 0.5);
    background-color: rgba(55, 0, 8, 0.78);
}

.critical #crosshair {
    background-color: rgb(255, 35, 60);
    border-color: rgb(255, 35, 60);
}

.critical #crosshair.highlight {
    background-color: rgba(255, 35, 60, 0);
}
