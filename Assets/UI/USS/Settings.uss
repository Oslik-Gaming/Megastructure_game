/* Settings.uss — экран настроек в стиле CRT-терминала (как MainMenu / PauseMenu) */

* {
    border-width: 0;
    outline-width: 0;
}

.scale-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(5, 10, 5);
}

.main-container {
    width: 1920px;
    height: 1080px;
    background-color: rgb(5, 10, 5);
    flex-direction: column;
    font-family: "Courier New", "Consolas", monospace;
    position: relative;
    overflow: hidden;
}

/* ==== Углы (как в MainMenu) ==== */

.corner {
    position: absolute;
    width: 20px;
    height: 20px;
    pointer-events: none;
    opacity: 0.7;
}

.corner-tl { top: 15px;    left: 15px;   border-top-width: 2px;    border-top-color: rgb(0, 255, 65);    border-left-width: 2px;  border-left-color: rgb(0, 255, 65); }
.corner-tr { top: 15px;    right: 15px;  border-top-width: 2px;    border-top-color: rgb(0, 255, 65);    border-right-width: 2px; border-right-color: rgb(0, 255, 65); }
.corner-bl { bottom: 15px; left: 15px;   border-bottom-width: 2px; border-bottom-color: rgb(0, 255, 65); border-left-width: 2px;  border-left-color: rgb(0, 255, 65); }
.corner-br { bottom: 15px; right: 15px;  border-bottom-width: 2px; border-bottom-color: rgb(0, 255, 65); border-right-width: 2px; border-right-color: rgb(0, 255, 65); }

/* ==== Верхняя / нижняя панели ==== */

.top-bar {
    height: 50px;
    padding-left: 40px;
    padding-top: 15px;
    background-color: rgba(0, 10, 0, 0.9);
    flex-direction: row;
    align-items: center;
}

.system-label {
    font-size: 18px;
    color: rgb(0, 204, 51);
    -unity-text-align: middle-left;
    letter-spacing: 2px;
}

.cursor {
    width: 10px;
    height: 20px;
    background-color: rgb(0, 255, 65);
    margin-left: 15px;
}

.bottom-bar {
    height: 50px;
    padding-left: 40px;
    padding-top: 15px;
    background-color: rgba(0, 10, 0, 0.9);
}

.hint-label {
    font-size: 16px;
    color: rgb(0, 204, 51);
    -unity-text-align: middle-left;
    letter-spacing: 2px;
}

/* ==== Контент ==== */

.settings-content {
    flex: 1;
    flex-direction: column;
    padding: 50px 100px;
}

.settings-title {
    font-size: 56px;
    font-weight: bold;
    color: rgb(0, 204, 51);
    margin-bottom: 40px;
    -unity-text-align: middle-left;
    letter-spacing: 6px;
}

/* ==== Строки настроек (слайдеры) ==== */

.settings-row {
    width: 860px;
    margin-bottom: 34px;
    border-left-width: 2px;
    border-left-color: transparent;
    padding-left: 24px;
}

.row-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.row-label {
    font-size: 26px;
    color: rgb(0, 204, 51);
    letter-spacing: 2px;
}

.row-value {
    font-size: 26px;
    color: rgb(0, 204, 51);
}

/* ==== Слайдеры (зелёный CRT) ==== */

.settings-slider {
    width: 800px;
    height: 30px;
}

.settings-slider .unity-base-slider__tracker,
.settings-slider .unity-slider__tracker {
    height: 10px;
    margin-top: 10px;
    background-color: rgb(0, 40, 10);
    border-width: 1px;
    border-color: rgb(0, 136, 34);
    border-radius: 0;
}

.settings-slider .unity-base-slider__fill,
.settings-slider .unity-slider__fill {
    height: 10px;
    margin-top: 10px;
    background-color: rgb(0, 255, 65);
    border-radius: 0;
}

.settings-slider .unity-base-slider__dragger,
.settings-slider .unity-slider__dragger {
    background-color: rgb(0, 255, 65);
    border-width: 0;
    border-radius: 0;
    width: 12px;
    height: 30px;
}

.settings-slider .unity-base-slider__dragger-border,
.settings-slider .unity-slider__dragger-border {
    border-width: 0;
    background-color: rgb(0, 255, 65);
    border-radius: 0;
}

/* ==== Список управления ==== */

.section-label {
    font-size: 26px;
    color: rgb(0, 204, 51);
    margin-top: 10px;
    margin-bottom: 16px;
    letter-spacing: 3px;
}

.controls-list {
    width: 900px;
    margin-bottom: 24px;
}

.controls-header {
    font-size: 26px;
    color: rgb(0, 255, 65);
    margin-top: 24px;
    margin-bottom: 14px;
    letter-spacing: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 255, 65, 0.4);
    padding-bottom: 8px;
}

.controls-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 14px;
}

.controls-action {
    font-size: 26px;
    color: rgb(0, 170, 45);
    letter-spacing: 1px;
    white-space: nowrap;
}

.controls-keys {
    font-size: 26px;
    color: rgb(0, 255, 65);
    letter-spacing: 1px;
    -unity-text-align: middle-right;
    white-space: nowrap;
}

/* ==== Прокручиваемый контент настроек ==== */

.settings-scroll {
    flex-grow: 1;
    margin-bottom: 24px;
}

/* Отступ справа, чтобы строки не наезжали на вертикальный скроллбар */
.settings-scroll .unity-scroll-view__content-viewport {
    padding-right: 40px;
}

/* Скроллбар в стиле CRT (зелёный) */
.settings-scroll .unity-scroller--vertical {
    width: 20px;
}

.settings-scroll .unity-scroller--vertical #unity-tracker,
.settings-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgb(0, 40, 10);
    border-width: 1px;
    border-color: rgb(0, 136, 34);
    border-radius: 0;
    width: 20px;
}

.settings-scroll .unity-scroller--vertical #unity-dragger,
.settings-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(0, 255, 65);
    border-width: 0;
    border-radius: 0;
    width: 20px;
}

.settings-scroll .unity-scroller--vertical #unity-dragger:hover,
.settings-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(120, 255, 150);
}

/* Спрятать стрелки-кнопки скроллбара (в CRT-стиле не нужны) */
.settings-scroll .unity-scroller--vertical #unity-low-button,
.settings-scroll .unity-scroller--vertical #unity-high-button,
.settings-scroll .unity-scroller--vertical .unity-base-slider__low-button,
.settings-scroll .unity-scroller--vertical .unity-base-slider__high-button {
    display: none;
}

/* ==== Кнопка Назад (как menu-button) ==== */

.menu-button {
    width: 500px;
    height: 65px;
    font-size: 32px;
    font-family: "Courier New", "Consolas", monospace;
    color: rgb(0, 204, 51);
    background-color: transparent;
    background-image: none;
    border-width: 0;
    border-radius: 0;
    outline-width: 0;
    -unity-text-align: middle-left;
    padding-left: 30px;
}

.back-button.selected,
.back-button:hover {
    color: rgb(0, 255, 65);
    text-shadow: 0 0 10px rgba(0, 255, 65, 0.7);
    padding-left: 45px;
}
